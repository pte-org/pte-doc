// =============================================================================
// PTE_Exam_and_Grading
// =============================================================================

Project PTE_Exam_and_Grading {
  database_type: 'PostgreSQL'
  Note: '''
    Core Examination, Blueprints, Sessions, Attempts & Grading
  '''
}

TableGroup Assessment_Definitions_and_Blueprints {
  exam_definitions
  exam_definition_items
  exam_definition_cefr_targets
  exam_blueprints
  blueprint_items
  exam_versions
  exam_version_items
}

TableGroup Exam_Scheduling_and_Registration {
  exam_sessions
  exam_session_proctors
  exam_session_selected_skills
  exam_session_audience_sources
  exam_session_cefr_targets
  exam_registrations
}

TableGroup Exam_Delivery_and_Attempts {
  exam_attempts
  attempt_answers
  exam_incidents
}

TableGroup Scoring_and_Grading {
  grading_assignments
  grading_issues
  answer_evaluations
  exam_results
  scoring_rubric_versions
  scoring_rubric_activation_audits
}

// =============================================================================
// TABLES
// =============================================================================

Table exam_definitions {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  author_user_public_id uuid
  code varchar(255) [not null]
  lock_version bigint [not null]
  name varchar(255) [not null]
  rejection_reason varchar(1000)
  status varchar(255) [not null]
  template_policy varchar(16) [not null]
  version integer [not null]
  tenant_id uuid
  base_definition_public_id uuid
  sw_min_seconds integer
  sw_max_seconds integer
  reading_min_seconds integer
  reading_max_seconds integer
  listening_min_seconds integer
  listening_max_seconds integer
  total_max_seconds integer
  rubric_version_public_id uuid
}

Table exam_definition_items {
  exam_definition_id bigint [not null]
  listening_weight numeric(5, 2) [not null]
  max_count integer [not null]
  min_count integer [not null]
  overall_weight numeric(5, 2) [not null]
  prep_seconds integer [not null]
  reading_weight numeric(5, 2) [not null]
  response_seconds integer [not null]
  runtime_answer_schema_version integer
  runtime_authoring_contract_key varchar(96)
  runtime_authoring_contract_version integer
  runtime_behavior_key varchar(64)
  runtime_contract_version integer
  runtime_min_app_version varchar(32)
  runtime_profile_key varchar(96)
  runtime_profile_status varchar(16)
  runtime_profile_version integer
  runtime_renderer_key varchar(96)
  runtime_required_client_capabilities varchar(512)
  runtime_scoring_mode varchar(16)
  runtime_scoring_profile_key varchar(64)
  runtime_scoring_profile_version integer
  runtime_screen_key varchar(96)
  scoring_method varchar(255) [not null]
  section varchar(255) [not null]
  sequence integer [not null]
  speaking_weight numeric(5, 2) [not null]
  task_type varchar(255)
  task_type_key varchar(64) [not null]
  writing_weight numeric(5, 2) [not null]
}

Table exam_definition_cefr_targets {
  exam_definition_id bigint [pk]
  level varchar(2) [pk]
  percent integer [not null]
}

Table exam_blueprints {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  author_user_public_id uuid
  name varchar(255) [not null]
  rejection_reason varchar(255)
  status varchar(255) [not null]
  tenant_id uuid
  version bigint [not null]
}

Table blueprint_items {
  blueprint_id bigint [not null]
  order_index integer [not null]
  question_public_id uuid [not null]
  section varchar(255) [not null]
}

Table exam_versions {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  exam_definition_public_id uuid [not null]
  exam_definition_version integer [not null]
  generation_algorithm_version varchar(32)
  generation_seed bigint
  name varchar(255) [not null]
  pool_policy_fingerprint varchar(128)
  source_blueprint_public_id uuid [not null]
  tenant_id uuid
  version integer [not null]
  assembly_report text
}

Table exam_version_items {
  exam_version_id bigint [not null]
  audio_prompt_ref uuid
  correct_answer_text text
  image_prompt_ref uuid
  max_word_count integer
  min_word_count integer
  options_json text
  order_index integer [not null]
  prompt_text text
  pte_task_type varchar(255)
  public_id uuid [not null]
  reference_answer_text text
  runtime_answer_schema_version integer
  runtime_authoring_contract_key varchar(96)
  runtime_authoring_contract_version integer
  runtime_behavior_key varchar(64)
  runtime_contract_version integer
  runtime_mapping_status varchar(32)
  runtime_mapping_version varchar(32)
  runtime_min_supported_app_version varchar(32)
  runtime_profile_key varchar(96)
  runtime_profile_status varchar(16)
  runtime_profile_version integer
  runtime_renderer_key varchar(96)
  runtime_required_client_capabilities varchar(512)
  runtime_scoring_configuration_digest varchar(128)
  runtime_scoring_implementation_version varchar(96)
  runtime_scoring_mode varchar(16)
  runtime_scoring_profile_key varchar(64)
  runtime_scoring_profile_version integer
  runtime_screen_key varchar(96)
  section varchar(255) [not null]
  source_question_public_id uuid [not null]
  task_type_code varchar(64)
  task_type_display_name varchar(128)
  task_type_key varchar(64) [not null]
  title varchar(255) [not null]
}

Table exam_sessions {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  capacity integer [not null]
  closes_at timestamptz [not null]
  draft_version bigint [not null]
  exam_definition_public_id uuid
  exam_definition_version integer
  exam_mode varchar(16)
  exam_version_public_id uuid
  grading_completed_at timestamptz
  grading_frozen_at timestamptz
  grading_frozen_by_public_id uuid
  grading_marking_mode varchar(24)
  grading_preview_version varchar(128)
  grading_status varchar(16)
  license_key varchar(64) [not null]
  max_retries_per_student integer [not null]
  name varchar(255) [not null]
  opens_at timestamptz [not null]
  answer_integrity_level varchar(255)
  device_check_required boolean
  lockdown_mode varchar(255)
  proctor_required boolean
  replay_policy_limit integer
  replay_policy_type varchar(255)
  publication_locked_at timestamptz
  publication_public_id uuid
  reuse_policy varchar(40)
  series_key varchar(128)
  session_code varchar(24) [unique, not null]
  status varchar(255) [not null]
  subscription_id uuid [not null]
  tenant_id uuid [not null]
  avoid_repeated_questions boolean [not null, default: false]
}

Table exam_session_proctors {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  proctor_public_id uuid [not null]
  role varchar(255)
  tenant_id uuid [not null]
  session_id bigint [not null]
}

Table exam_session_selected_skills {
  session_id bigint [pk]
  skill varchar(16) [pk]
}

Table exam_session_audience_sources {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  created_by uuid
  source_public_id uuid [not null]
  source_type varchar(16) [not null]
  tenant_id uuid [not null]
  session_id bigint [not null]
}

Table exam_session_cefr_targets {
  session_id bigint [pk]
  level varchar(2) [pk]
  percent integer [not null]
}

Table exam_registrations {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  attendance_status varchar(32) [not null]
  attendance_version bigint [not null]
  identity_note varchar(1000)
  identity_status varchar(32) [not null]
  last_action_at timestamptz
  last_actor_public_id uuid
  last_actor_role varchar(32)
  last_reason_or_note varchar(1000)
  license_key varchar(64) [not null]
  prior_session_name varchar(255)
  prior_session_public_id uuid
  prior_status varchar(16)
  published_at timestamptz
  reason varchar(32)
  source_summary varchar(1000)
  status varchar(16) [not null]
  student_public_id uuid [not null]
  tenant_id uuid [not null]
  session_id bigint [not null]
}

Table exam_attempts {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  active_section varchar(255)
  answer_integrity_level varchar(255) [not null]
  attempt_number integer [not null]
  capability_fingerprint varchar(2048)
  current_order_index integer [not null, default: 0]
  device_check_passed_at timestamptz
  device_check_required boolean [not null]
  exam_definition_public_id uuid [not null]
  exam_definition_version integer
  exam_end_time timestamptz
  exam_mode varchar(16) [not null]
  exam_version_public_id uuid [not null]
  grading_excluded boolean [not null]
  grading_exclusion_reason varchar(500)
  last_play_allowed boolean
  last_play_request_id varchar(255)
  last_seen_at timestamptz
  lockdown_mode varchar(20)
  max_retries_per_student integer [not null, default: 0]
  play_count integer [not null, default: 0]
  proctor_required boolean [not null]
  replay_policy_limit integer
  replay_policy_type varchar(255) [not null]
  section_started_at timestamptz
  session_public_id uuid [not null]
  started_at timestamptz
  status varchar(255) [not null]
  student_public_id uuid [not null]
  submitted_at timestamptz
  tenant_id uuid [not null]
  version bigint
}

Table attempt_answers {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  confidence varchar(16)
  expired boolean [not null]
  item_order_index integer [not null]
  item_public_id uuid [not null]
  payload text
  selected_evaluation_public_id uuid
  selected_score_source varchar(16)
  selected_score_source_at timestamptz
  selected_score_source_by uuid
  status varchar(255) [not null]
  attempt_id bigint [not null]
}

Table exam_incidents {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  attempt_public_id uuid
  client_event_id varchar(128)
  client_occurred_at timestamptz
  current_owner_name varchar(255)
  current_owner_role varchar(32) [not null]
  description text
  detected_at timestamptz [not null]
  origin varchar(16) [not null]
  reporter_name varchar(255)
  reporter_public_id uuid
  reporter_role varchar(32)
  resolution_summary text
  session_public_id uuid [not null]
  severity varchar(32) [not null]
  status varchar(32) [not null]
  student_public_id uuid
  tenant_id uuid [not null]
  title varchar(255) [not null]
  type varchar(64) [not null]
}

Table grading_assignments {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  assigned_at timestamptz [not null]
  assigned_by_public_id uuid [not null]
  attempt_public_id uuid [not null]
  eligible_answer_count integer [not null]
  examiner_public_id uuid [not null]
  finalized_at timestamptz
  session_public_id uuid [not null]
  started_at timestamptz
  status varchar(16) [not null]
  tenant_id uuid [not null]
  work_version bigint [not null]
}

Table grading_issues {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  answer_public_id uuid
  assignment_id bigint [not null]
  description varchar(2000) [not null]
  reported_at timestamptz [not null]
  reported_by uuid [not null]
  resolution varchar(2000)
  resolved_at timestamptz
  resolved_by uuid
  status varchar(255) [not null]
  tenant_id uuid [not null]
  type varchar(255) [not null]
}

Table answer_evaluations {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  answer_public_id uuid [not null]
  attempt_public_id uuid [not null]
  lock_version bigint [not null]
  score integer
  scored_at timestamptz
  session_public_id uuid [not null]
  source varchar(16) [not null]
  tenant_id uuid [not null]
  ai_dispatched_at timestamptz
  ai_model varchar(160)
  ai_provider varchar(64)
  ai_provider_category varchar(16)
  ai_provider_version varchar(100)
  criteria_scores_json text
  detail_json text
  dispatch_token bigint
  exam_definition_public_id uuid
  failure_reason varchar(40)
  fallback boolean
  feedback text
  item_public_id uuid
  scoring_method varchar(16)
  section varchar(255)
  status varchar(16)
  task_type varchar(255)
  teacher_score integer
  teacher_scored_at timestamptz
  transcript text
  assignment_id bigint
  comment varchar(2000)
  decision_kind varchar(32)
  draft_version bigint
  examiner_public_id uuid
  expected_review_version varchar(128)
  request_fingerprint varchar(128)
  request_public_id uuid
  reviewed_ai_score integer
  reviewed_ai_version varchar(128)
  saved_at timestamptz
  examiner_status varchar(16)
  submitted_at timestamptz
  carried_over_from_examiner_public_id uuid
  rubric_version_public_id uuid
  trait_scores_json text
  ai_gap_reasons_json text
}

Table exam_results {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  attempt_public_id uuid [unique, not null]
  listening_score integer
  overall_score integer
  publication_cohort_size integer
  publication_public_id uuid
  published boolean [not null]
  published_at timestamptz
  published_by_public_id uuid
  reading_score integer
  report_snapshot_json text
  session_public_id uuid [not null]
  snapshot_public_id uuid
  speaking_score integer
  student_public_id uuid [not null]
  tenant_id uuid [not null]
  writing_score integer
}

Table scoring_rubric_versions {
  id bigint [pk]
  public_id uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted boolean [not null, default: FALSE]
  lock_version bigint [not null, default: 0]
  version_no integer [not null]
  status varchar(16) [not null]
  parameters jsonb [not null]
  catalog_version integer [not null]
  author_user_public_id uuid
  approver_user_public_id uuid
  rejection_reason varchar(1000)
  submitted_at timestamptz
  decided_at timestamptz
  activated_at timestamptz
  retired_at timestamptz
  updated_by_user_public_id uuid
}

Table scoring_rubric_activation_audits {
  id bigint [pk]
  public_id uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted boolean [not null, default: FALSE]
  version_public_id uuid [not null]
  previous_active_public_id uuid
  actor_user_public_id uuid [not null]
  activated_at timestamptz [not null]
  diff_summary text
  reason varchar(1000)
}

// =============================================================================
// RELATIONSHIPS
// =============================================================================

Ref: exam_definitions.rubric_version_public_id > scoring_rubric_versions.public_id
Ref: exam_definition_items.exam_definition_id > exam_definitions.id [delete: cascade]
Ref: exam_definition_cefr_targets.exam_definition_id > exam_definitions.id [delete: cascade]
Ref: blueprint_items.blueprint_id > exam_blueprints.id [delete: cascade]
Ref: exam_versions.exam_definition_public_id > exam_definitions.public_id
Ref: exam_versions.source_blueprint_public_id > exam_blueprints.public_id
Ref: exam_version_items.exam_version_id > exam_versions.id [delete: cascade]
Ref: exam_sessions.exam_definition_public_id > exam_definitions.public_id
Ref: exam_sessions.exam_version_public_id > exam_versions.public_id
Ref: exam_session_proctors.session_id > exam_sessions.id [delete: cascade]
Ref: exam_session_selected_skills.session_id > exam_sessions.id [delete: cascade]
Ref: exam_session_audience_sources.session_id > exam_sessions.id [delete: cascade]
Ref: exam_session_cefr_targets.session_id > exam_sessions.id [delete: cascade]
Ref: exam_registrations.session_id > exam_sessions.id [delete: cascade]
Ref: exam_attempts.session_public_id > exam_sessions.public_id
Ref: exam_attempts.exam_version_public_id > exam_versions.public_id
Ref: attempt_answers.attempt_id > exam_attempts.id [delete: cascade]
Ref: attempt_answers.item_public_id > exam_version_items.public_id
Ref: exam_incidents.attempt_public_id > exam_attempts.public_id
Ref: exam_incidents.session_public_id > exam_sessions.public_id
Ref: grading_assignments.attempt_public_id > exam_attempts.public_id
Ref: grading_assignments.session_public_id > exam_sessions.public_id
Ref: grading_issues.assignment_id > grading_assignments.id
Ref: grading_issues.answer_public_id > attempt_answers.public_id
Ref: answer_evaluations.attempt_public_id > exam_attempts.public_id
Ref: answer_evaluations.answer_public_id > attempt_answers.public_id
Ref: answer_evaluations.rubric_version_public_id > scoring_rubric_versions.public_id
Ref: exam_results.attempt_public_id > exam_attempts.public_id
Ref: exam_results.session_public_id > exam_sessions.public_id
Ref: scoring_rubric_activation_audits.version_public_id > scoring_rubric_versions.public_id
