%% UML 2.5 state machine. Transition label syntax: trigger [guard] / effect.
%% Source: notification/internal/repository/InboxDeliveryStore.java, InboxDeliveryService, InboxDeliveryWorker
stateDiagram-v2
  [*] --> PENDING : / fan out content to recipients
  PENDING --> PROCESSING : worker claims / attempts + 1, set lease_until
  PROCESSING --> PROCESSING : another worker claims [now > lease_until]
  PROCESSING --> DELIVERED : delivered
  PROCESSING --> SUPPRESSED : delivery no longer needed
  PROCESSING --> PENDING : delivery error [transient] / schedule next_attempt_at
  PROCESSING --> FAILED : delivery error [permanent or attempts exhausted]
  PENDING --> SUPPRESSED : when(SESSION_CLOSING_SOON reminder no longer valid)
  FAILED --> PENDING : admin resends / attempts = 0
  DELIVERED --> [*]
  SUPPRESSED --> [*]
