---
title: D4 AnswerEvaluation (AiEvaluation và ExaminerEvaluation)
---
%% Nguồn: scoring/domain/AiEvaluation.java, ScoringCommandService, AiScoringDispatcher, AiScoringWorker
stateDiagram-v2
  state "AiEvaluation.status" as ai {
    [*] --> PENDING : câu trả lời cần chấm
    PENDING --> AI_SCORING : host yêu cầu chấm, markAiDispatched (dispatch_token + 1)
    PENDING --> SCORED : chấm khách quan (OBJECTIVE)
    AI_SCORING --> SCORED : worker nhận kết quả đúng dispatch_token
    AI_SCORING --> SCORING_FAILED : job vào DLQ, ghi failure_reason
    AI_SCORING --> AI_SCORING : job treo quá hạn, host yêu cầu lại
    SCORING_FAILED --> AI_SCORING : host yêu cầu chấm lại (isRescorable)
    SCORED --> [*]
  }
  state "ExaminerEvaluation.examiner_status" as ex {
    [*] --> DRAFT : giám khảo lưu nháp
    DRAFT --> DRAFT : sửa nháp (draft_version)
    DRAFT --> SUBMITTED : nộp điểm (decision_kind CONFIRM_AI / MANUAL)
    SUBMITTED --> [*]
  }
