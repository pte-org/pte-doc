%% UML 2.5 state machine. Transition label syntax: trigger [guard] / effect.
%% Source: attempt/domain/ExamAttempt.java, AttemptStartFlow, AttemptLifecycleService
%% grading_excluded is a flag, not a state.
stateDiagram-v2
  [*] --> CREATED : / student enters the session (preflight)
  CREATED --> IN_PROGRESS : begin
  IN_PROGRESS --> IN_PROGRESS : answer, change section, resume
  IN_PROGRESS --> SUBMITTED : submit [actor = student]
  IN_PROGRESS --> SUBMITTED : when(time limit reached)
  IN_PROGRESS --> SUBMITTED : force submit [actor = proctor]
  SUBMITTED --> [*]
  note right of SUBMITTED
    AttemptAnswer.status goes SUBMITTED to SCORED
  end note
