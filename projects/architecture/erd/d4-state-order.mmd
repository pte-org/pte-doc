%% UML 2.5 state machine. Transition label syntax: trigger [guard] / effect.
%% Source: billing/domain/Order.java, OrderExpirationService
%% Every transition leaves PENDING. Repeating a call in a final state has no effect (idempotent).
stateDiagram-v2
  [*] --> PENDING : / create PayOS payment link
  PENDING --> PAID : payment webhook / record OrderPayment
  PENDING --> CANCELLED : cancel
  PENDING --> EXPIRED : when(order past its expiry)
  PAID --> [*]
  CANCELLED --> [*]
  EXPIRED --> [*]
