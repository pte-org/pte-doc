}

Table idempotency_keys {
  id bigint [pk]
  created_at timestamptz [not null]
  deleted boolean [not null]
  public_id uuid [unique, not null]
  updated_at timestamptz [not null]
  completed boolean [not null]
  expires_at timestamptz [not null]
  idempotency_key varchar(128) [not null]
  organization_id uuid [not null]
  request_hash varchar(128) [not null]
  result jsonb
  scope varchar(32) [not null]
}

// =============================================================================
// RELATIONSHIPS & FOREIGN KEYS
// =============================================================================

// --- Identity & Access Management ---
Ref: user_roles.user_id > users.id [delete: cascade]
Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: password_reset_tokens.user_id > users.id [delete: cascade]
Ref: organization_members.user_id > users.id
Ref: organization_members.organization_id > organizations.id
Ref: organization_member_roles.member_id > organization_members.id [delete: cascade]
Ref: organization_quota_grants.organization_id > organizations.id

// --- Academic & Enrollment ---
Ref: programs.organization_id > organizations.id
Ref: classes.program_id > programs.id
Ref: class_students.class_id > classes.id
Ref: class_students.student_public_id > users.public_id

// --- Item Bank & Questions ---
Ref: questions.task_type_key > question_types.code
Ref: question_options.question_id > questions.id [delete: cascade]
Ref: question_generation_job_items.job_id > question_generation_jobs.id [delete: cascade]
Ref: question_generation_jobs.requested_by_user_public_id > users.public_id
Ref: questions.generation_job_public_id > question_generation_jobs.public_id

// --- Assessment & Blueprints ---
Ref: exam_definitions.rubric_version_public_id > scoring_rubric_versions.public_id
Ref: exam_definition_items.exam_definition_id > exam_definitions.id [delete: cascade]
Ref: exam_definition_cefr_targets.exam_definition_id > exam_definitions.id [delete: cascade]
Ref: exam_blueprints.author_user_public_id > users.public_id
Ref: blueprint_items.blueprint_id > exam_blueprints.id [delete: cascade]
Ref: exam_versions.exam_definition_public_id > exam_definitions.public_id
Ref: exam_versions.source_blueprint_public_id > exam_blueprints.public_id
Ref: exam_version_items.exam_version_id > exam_versions.id [delete: cascade]
Ref: exam_version_items.source_question_public_id > questions.public_id

// --- Scheduling & Sessions ---
Ref: exam_sessions.exam_definition_public_id > exam_definitions.public_id
Ref: exam_sessions.exam_version_public_id > exam_versions.public_id
Ref: exam_session_proctors.session_id > exam_sessions.id [delete: cascade]
Ref: exam_session_proctors.proctor_public_id > users.public_id
Ref: exam_session_selected_skills.session_id > exam_sessions.id [delete: cascade]
Ref: exam_session_audience_sources.session_id > exam_sessions.id [delete: cascade]
Ref: exam_session_cefr_targets.session_id > exam_sessions.id [delete: cascade]
Ref: exam_registrations.session_id > exam_sessions.id [delete: cascade]
Ref: exam_registrations.student_public_id > users.public_id

// --- Attempts & Delivery ---
Ref: exam_attempts.session_public_id > exam_sessions.public_id
Ref: exam_attempts.exam_version_public_id > exam_versions.public_id
Ref: exam_attempts.student_public_id > users.public_id
Ref: attempt_answers.attempt_id > exam_attempts.id [delete: cascade]
Ref: attempt_answers.item_public_id > exam_version_items.public_id
Ref: exam_incidents.attempt_public_id > exam_attempts.public_id
Ref: exam_incidents.session_public_id > exam_sessions.public_id
Ref: exam_incidents.student_public_id > users.public_id

// --- Scoring & Grading ---
Ref: grading_assignments.attempt_public_id > exam_attempts.public_id
Ref: grading_assignments.session_public_id > exam_sessions.public_id
Ref: grading_assignments.examiner_public_id > users.public_id
Ref: grading_issues.assignment_id > grading_assignments.id
Ref: grading_issues.answer_public_id > attempt_answers.public_id
Ref: answer_evaluations.attempt_public_id > exam_attempts.public_id
Ref: answer_evaluations.answer_public_id > attempt_answers.public_id
Ref: answer_evaluations.rubric_version_public_id > scoring_rubric_versions.public_id
Ref: exam_results.attempt_public_id > exam_attempts.public_id
Ref: exam_results.session_public_id > exam_sessions.public_id
Ref: exam_results.student_public_id > users.public_id
Ref: scoring_rubric_activation_audits.version_public_id > scoring_rubric_versions.public_id

// --- Practice & Learning ---
Ref: practice_sessions.student_public_id > users.public_id
Ref: practice_sessions.mock_test_id > practice_mock_tests.id
Ref: practice_responses.practice_session_id > practice_sessions.id [delete: cascade]
Ref: practice_responses.source_question_public_id > questions.public_id
Ref: practice_mock_test_items.mock_test_id > practice_mock_tests.id [delete: cascade]
Ref: practice_mock_test_items.question_public_id > questions.public_id
Ref: practice_student_profiles.student_public_id > users.public_id
Ref: chat_usage.student_id > users.public_id

// --- Billing & Commerce ---
Ref: orders.plan_id > service_plans.public_id
Ref: orders.tenant_id > organizations.public_id
Ref: order_payments.order_id > orders.id [delete: cascade]
Ref: subscriptions.plan_id > service_plans.public_id
Ref: subscriptions.tenant_id > organizations.public_id
Ref: license_codes.plan_id > service_plans.public_id
Ref: license_codes.subscription_id > subscriptions.id
Ref: license_codes.redeemed_by_tenant_id > organizations.public_id

// --- Notifications ---
Ref: notification_recipients.content_public_id > notifications.public_id
Ref: notification_recipients.recipient_user_public_id > users.public_id
Ref: notification_recipient_streams.recipient_user_public_id > users.public_id
Ref: notification_inbox_snapshots.recipient_user_public_id > users.public_id
Ref: notification_announcements.author_user_public_id > users.public_id

// --- Support & System ---
Ref: support_ticket.submitter_user_public_id > users.public_id
Ref: support_ticket_note.ticket_id > support_ticket.id [delete: cascade]
Ref: support_ticket_note.admin_public_id > users.public_id
